# 自动检测文本文件并规范化行尾
* text=auto

# 源代码文件
*.js text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf

# Shell脚本
*.sh text eol=lf

# Windows批处理文件
*.bat text eol=crlf
*.cmd text eol=crlf

# Docker文件
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# 二进制文件
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.tar binary
*.gz binary