{
  "name": "translation-gui-tool",
  "version": "1.0.0",
  "description": "图形化语言包翻译管理工具",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "translate": "node translate-json.js",
    "docker:build": "docker build -t translation-gui .",
    "docker:run": "docker run -p 3000:3000 -v $(pwd)/language-package:/app/language-package translation-gui",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up",
    "docker:logs": "docker-compose logs -f"
  },
  "dependencies": {
    "archiver": "^6.0.2",
    "axios": "^1.13.2",
    "express": "^4.22.1",
    "md5": "^2.3.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "keywords": [
    "translation",
    "i18n",
    "gui",
    "language-pack"
  ],
  "author": "Translation Tool",
  "license": "MIT"
}
